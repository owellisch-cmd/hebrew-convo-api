# Generate a real one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string

# Local dev uses SQLite. In a hosted environment use Postgres, e.g.
#   postgresql://user:password@host:5432/dbname
# (SQLite will NOT survive on serverless/ephemeral hosts.)
DATABASE_URL=sqlite:///./app.db

# Optional. Without it, a templated explanation is used instead.
ANTHROPIC_API_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated browser origins allowed to call this API.
# In production set this to your deployed frontend URL, e.g.
#   CORS_ORIGINS=https://planwise.vercel.app
CORS_ORIGINS=http://localhost:5173
